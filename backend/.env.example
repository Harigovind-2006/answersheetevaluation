# ─── OpenAI (for GPT Analysis, Optional) ──────────────────────────────────────
# API key for OpenAI (now optional, was used for GPT-5.4 OCR)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ─── Gemini (Grading & Extraction) ───────────────────────────────────────────
# Get from: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=

# ─── Supabase (Database, Auth, Storage) ───────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=answer-sheets

# ─── Server Config ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000, http://localhost:8080

# ─── Image Processing ─────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
MAX_PAGES=10
DESKEW_ENABLED=true
DENOISE_ENABLED=true
CONTRAST_ENHANCE_ENABLED=true
BINARIZE_ENABLED=true

# ─── EasyOCR Config (Local) ───────────────────────────────────────────────────
# Answers with confidence below this threshold are discarded
OCR_CONFIDENCE_THRESHOLD=0.50
# Primary languages for detection (comma separated, e.g., en,fr)
OCR_LANGUAGES=en
# GPU activation (1 = enabled, 0 = disabled). EasyOCR will auto-detect if not set.
OCR_USE_GPU=1
